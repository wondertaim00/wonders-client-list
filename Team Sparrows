async function saveInlineEdit(index) {

    const item = clients[index];

    if (!item || !item.id) {
        alert("Hindi makita ang database ID ng client.");
        return;
    }

    const dateSubmitted =
        document.getElementById(
            "editDateSubmitted" + index
        ).value;

    const policyNumber =
        document.getElementById(
            "editPolicy" + index
        ).value.trim();

    const client =
        document.getElementById(
            "editClient" + index
        ).value.trim();

    const product =
        document.getElementById(
            "editProduct" + index
        ).value.trim();

    const faceAmount =
        document.getElementById(
            "editFaceAmount" + index
        ).value;

    const paymentMode =
        document.getElementById(
            "editPaymentMode" + index
        ).value;

    const premium =
        document.getElementById(
            "editPremium" + index
        ).value;

    const acOverride =
        document.getElementById(
            "editAC" + index
        ).value;

    const dateSettled =
        document.getElementById(
            "editDateSettled" + index
        ).value;

    const age =
        document.getElementById(
            "editAge" + index
        ).value;

    if (client === "") {
        alert("Please enter client name.");
        return;
    }

    if (paymentMode === "") {
        alert("Please select payment mode.");
        return;
    }

    if (premium === "") {
        alert("Please enter premium.");
        return;
    }

    const updatedClient = {

        date_submitted:
            dateSubmitted || null,

        policy_number:
            policyNumber,

        client:
            client,

        product:
            product,

        face_amount:
            Number(faceAmount || 0),

        payment_mode:
            paymentMode,

        premium:
            Number(premium || 0),

        ac_override:
            acOverride === ""
                ? null
                : Number(acOverride),

        date_settled:
            dateSettled || null,

        age:
            age === ""
                ? null
                : Number(age)
    };

    try {

        const response =
            await fetch(
                SUPABASE_URL +
                "/rest/v1/clients?id=eq." +
                item.id,
                {
                    method: "PATCH",

                    headers: {
                        "apikey": SUPABASE_KEY,
                        "Authorization":
                            "Bearer " + SUPABASE_KEY,
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(updatedClient)
                }
            );

        if (!response.ok) {

            const errorText =
                await response.text();

            console.log(
                "Supabase update error:",
                errorText
            );

            alert(
                "Hindi ma-update sa database.\n\n" +
                errorText
            );

            return;
        }

        alert("Client updated successfully!");

        await loadClients();

    }
    catch (error) {

        console.log(
            "Update error:",
            error
        );

        alert(
            "Hindi makakonekta sa Supabase.\n\n" +
            error
        );
    }
}
		

