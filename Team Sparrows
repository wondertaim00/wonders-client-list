function getAC(item) {

    if (
        item.acOverride !== undefined &&
        item.acOverride !== "" &&
        item.acOverride !== null
    ) {
        return Number(item.acOverride);
    }

    return calculateAC(
        item.product,
        item.faceAmount,
        item.age,
        item.premium
    );
}


function getNSC(item) {

    const ac = getAC(item);

    if (ac === null) {
        return null;
    }

    if (item.paymentMode === "Quarterly") {
        return ac * 4;
    }

    if (item.paymentMode === "Semi-Annual") {
        return ac * 2;
    }

    if (item.paymentMode === "Annual") {
        return ac;
    }

    return null;
}


