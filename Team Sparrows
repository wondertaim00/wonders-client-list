}

		function calculateAC(product, faceAmount, age, premium) {
    const fa = Number(faceAmount || 0);
    const clientAge = Number(age || 0);
    const prem = Number(premium || 0);

    let rate = null;

    if (product === "Sun Life Assure") {
        rate = 0.55;
    }
    else if (product === "Sun Maxilink Prime") {
        rate = 0.45;
    }

	 else if (product === "Sun Maxilink Bright") {
    rate = 0.20;
    }

    else if (product === "Sun Maxi 100") {
        rate = 0.50;
    }
    else if (product === "Elite 10") {
        if (fa >= 200000 && fa < 1000000) {
            rate = 0.45;
        }
        else if (fa >= 1000000) {
            rate = 0.50;
        }
    }
    else if (product === "Sun Fit and Well Adv 10") {
        if (clientAge <= 55) {
            rate = 0.35;
        }
        else if (clientAge <= 60) {
            rate = 0.30;
        }
    }
    else if (product === "Sun Fit and Well Adv 15") {
        if (clientAge <= 50) {
            rate = 0.40;
        }
        else if (clientAge <= 55) {
            rate = 0.35;
        }
    }
    else if (product === "Sun Fit and Well Adv 20") {
        if (clientAge <= 45) {
            rate = 0.45;
        }
        else if (clientAge <= 50) {
            rate = 0.40;
        }
    }

    if (rate === null || prem <= 0) {
        return null;
    }

    return prem * rate;
}


		function calculateNSC(product, faceAmount, age, premium, paymentMode) {
    const ac = calculateAC(
        product,
        faceAmount,
        age,
        premium
    );

    if (ac === null) {
        return null;
    }

    if (paymentMode === "Quarterly") {
        return ac * 4;
    }

    if (paymentMode === "Semi-Annual") {
        return ac * 2;
    }

    if (paymentMode === "Annual") {
        return ac;
    }

    return null;
				}
				
				

    async function addClient() {

    const advisor =
        document.getElementById("advisorName").value;

    const client =
        document.getElementById("clientName").value.trim();

    const policyNumber =
        document.getElementById("policyNumber").value.trim();

    const dateSubmitted =
        document.getElementById("dateSubmitted").value;

    const selectedPlan =
        document.querySelector('input[name="plan"]:checked');

    const plan =
        selectedPlan ? selectedPlan.value : "";

    const product =
        document.getElementById("product").value;

    const faceAmount =
        document.getElementById("faceAmount").value;

    const paymentMode =
        document.getElementById("paymentMode").value;

    const premium =
        document.getElementById("premium").value;

    const dateSettled =
        document.getElementById("dateSettled").value;

    const age =
        document.getElementById("age").value;


    /* CHECK TEAM */

    if (selectedTeam === "") {
        alert("Please select a team first.");
        return;
    }


    /* CHECK ADVISOR */

    if (
        advisorsByTeam[selectedTeam].length > 0 &&
        advisor === ""
    ) {
        alert("Please select an advisor.");
        return;
    }


    /* CHECK CLIENT */

    if (client === "") {
        alert("Please enter client name.");
        return;
    }


    /* CHECK DATE */

    if (dateSubmitted === "") {
        alert("Please select date submitted.");
        return;
    }


    /* CHECK PLAN */

    if (plan === "") {
        alert("Please select a plan.");
        return;
    }


    /* CHECK PRODUCT */

    if (product === "") {
        alert("Please select a product.");
        return;
    }


    /* CHECK FACE AMOUNT */

    if (faceAmount === "") {
        alert("Please enter face amount.");
        return;
    }


    /* CHECK PAYMENT MODE */

    if (paymentMode === "") {
        alert("Please select payment mode.");
        return;
    }


    /* CHECK PREMIUM */

    if (premium === "") {
        alert("Please enter premium.");
        return;
    }


    /* CHECK AGE FOR SFW */

    const sfwProducts = [
        "Sun Fit and Well Adv 10",
        "Sun Fit and Well Adv 15",
        "Sun Fit and Well Adv 20"
    ];

    if (sfwProducts.includes(product) && age === "") {
        alert("Please enter Age for Sun Fit and Well.");
        return;
    }


    /* SAVE TO SUPABASE */

    const newClient = {
        team: selectedTeam,
        advisor: advisor,
        client: client,
        policy_number: policyNumber,
        date_submitted: dateSubmitted,
        plan: plan,
        product: product,
        face_amount: Number(faceAmount),
        payment_mode: paymentMode,
        premium: Number(premium),
        ac_override: null,
        date_settled: dateSettled || null,
        age: age === "" ? null : Number(age)
    };


    try {

        const response = await fetch(
            SUPABASE_URL + "/rest/v1/clients",
            {
                method: "POST",

                headers: {
                    "apikey": SUPABASE_KEY,
                    "Authorization":
                        "Bearer " + SUPABASE_KEY,
                    "Content-Type":
                        "application/json",
                    "Prefer":
                        "return=representation"
                },

                body: JSON.stringify(newClient)
            }
        );


        if (!response.ok) {

            const errorText =
                await response.text();

            console.log(
                "Supabase error:",
                errorText
            );

            alert(
                "Hindi na-save sa database.\n\n" +
                errorText
            );

            return;
        }


        /* GET SAVED RECORD */

        const savedData =
            await response.json();

        console.log(
            "Saved to Supabase:",
            savedData
        );


        /* BACKUP LOCAL DATA FOR NOW */

        const localClient = {
            team: selectedTeam,
            advisor: advisor,
            client: client,
            policyNumber: policyNumber,
            dateSubmitted: dateSubmitted,
            plan: plan,
            product: product,
            faceAmount: faceAmount,
            paymentMode: paymentMode,
            premium: premium,
            dateSettled: dateSettled,
            age: age,
            acOverride: ""
        };


        clients.push(localClient);


        localStorage.setItem(
            "clientList",
            JSON.stringify(clients)
        );


        /* CLEAR FORM */

        document.getElementById("clientName").value = "";

        document.getElementById("policyNumber").value = "";

        document.getElementById("dateSubmitted").value = "";

        document.getElementById("tradPlan").checked = false;

        document.getElementById("vulPlan").checked = false;

        document.getElementById("product").innerHTML =
            '<option value="">Select Product</option>';

        document.getElementById("productSection").style.display =
            "none";

        document.getElementById("faceAmount").value = "";

        document.getElementById("paymentMode").value = "";

        document.getElementById("premium").value = "";

        document.getElementById("dateSettled").value = "";

        document.getElementById("age").value = "";

        document.getElementById("sameAsAdvisor").checked = false;


        alert("Client saved successfully!");


        displayClients();

    }

    catch (error) {

        console.log(
            "Connection error:",
            error
        );

        alert(
            "Hindi makakonekta sa Supabase.\n\n" +
            error
        );
    }

}

