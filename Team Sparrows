		function updateResultsPage() {

    const pages =
        document.querySelectorAll("#resultsPages .results-page");

    document.getElementById("pageNumber").textContent =
        "Page " +
        window.currentResultsPage +
        " of " +
        pages.length;

    document.getElementById("prevPage").style.visibility =
        window.currentResultsPage === 1
            ? "hidden"
            : "visible";

    document.getElementById("nextPage").style.visibility =
        window.currentResultsPage === pages.length
            ? "hidden"
            : "visible";
}


		function changeResultsPage(direction) {

    const pages =
        document.querySelectorAll("#resultsPages .results-page");

    let newPage =
        window.currentResultsPage + direction;

    if (newPage < 1) {
        newPage = 1;
    }

    if (newPage > pages.length) {
        newPage = pages.length;
    }

    pages.forEach(function(page, index) {
        page.classList.toggle(
            "active",
            index === newPage - 1
        );
    });

    window.currentResultsPage = newPage;

    updateResultsPage();
}
		
		
